{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile in Punto Padel",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "phone": { "type": "string" },
        "category": { "type": "string" },
        "preferredSide": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account document stored by user UID"
    }
  }
}
